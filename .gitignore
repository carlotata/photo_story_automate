# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Generated video outputs & temporary working directories
output/
work/

# User story inputs (exclude heavy media; keep sample template & instructions)
input/shorts/*
!input/shorts/pending/
input/shorts/pending/*
!input/shorts/pending/sample_story/
!input/shorts/pending/sample_story/*
!input/shorts/completed/
input/shorts/completed/*

input/long/*
!input/long/pending/
input/long/pending/*
!input/long/pending/sample_story/
!input/long/pending/sample_story/*
!input/long/completed/
input/long/completed/*

!input/README.md

# TTS Models (downloaded automatically via setup_model.py)
assets/kokoro-en-v0_19/
assets/*.tar.bz2
assets/*.zip

# Media artifacts
*.mp4
*.wav
*.aac
*.mp3

# Whitelist voice gallery samples so users can listen after cloning
!voice_samples/
!voice_samples/*

# Virtual Environments
.venv/
venv/
env/
ENV/

# System & IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
