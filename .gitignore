# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Track output directory in git, but ignore generated video files & folders
output/*
!output/.gitkeep
!output/shorts/
output/shorts/*
!output/shorts/.gitkeep
!output/long/
output/long/*
!output/long/.gitkeep
work/

# User story inputs (exclude heavy media; keep sample template)
input/*
!input/.gitkeep
!input/README.md
!input/shorts/
input/shorts/*
!input/shorts/.gitkeep
!input/shorts/sample_story/
input/shorts/sample_story/*
!input/shorts/sample_story/script.txt
!input/long/
input/long/*
!input/long/.gitkeep
!input/long/sample_story/
input/long/sample_story/*
!input/long/sample_story/script.txt

# TTS Models (downloaded automatically via setup_model.py)
assets/kokoro-en-v0_19/
assets/*.tar.bz2
assets/*.zip

# Media artifacts
*.mp4
*.wav
*.aac
*.mp3

# Whitelist voice gallery samples so users can listen after cloning
!voice_samples/
!voice_samples/*

# Virtual Environments
.venv/
venv/
env/
ENV/

# System & IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
